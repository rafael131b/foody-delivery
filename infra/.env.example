# Exemplo sem segredos. Copie para um mecanismo de ambiente local e substitua o JWT_SECRET.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000
DB_PATH=/data/foody.db
BACKEND_IMAGE=foody-backend:local
FRONTEND_IMAGE=foody-frontend:local
BACKEND_PORT=8080
FRONTEND_PORT=3000
